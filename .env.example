# Copy to .env.local

# Public URL of the deployed site (used for social share metadata)
NEXT_PUBLIC_SITE_URL=https://www.furtadoproperty.com.au

# Enquiry form delivery via Resend (https://resend.com). Without a key the form asks visitors to phone or email.
RESEND_API_KEY=
ENQUIRY_TO=info@furtadoproperty.com.au
# Must be an address on a domain verified in Resend
ENQUIRY_FROM=Furtado Property website <website@furtadoproperty.com.au>
