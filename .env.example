# Copy to .env.local

# Public URL of the deployed site (used for social share metadata)
NEXT_PUBLIC_SITE_URL=https://www.furtadoproperty.com.au

# Enquiry form delivery via Resend (https://resend.com). Without a key the API answers 503 and the form asks visitors to
# phone or email. Test with `npm run mail:test` (dev server running) or `npm run mail:test -- --direct`.
RESEND_API_KEY=
# Who receives every enquiry, comma-separated. Defaults to Kylie and Graham when unset (lib/enquiry-mail.ts).
ENQUIRY_TO=kylie@furtadoproperty.com.au,graham@furtadoproperty.com.au
# Must be an address on a domain verified in Resend (furtadoproperty.com.au is). This is also the code default.
ENQUIRY_FROM=Furtado Property website <website@furtadoproperty.com.au>
